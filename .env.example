# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Used by both the backend and (in the Docker path) the db container.
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=ticketing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (composed from the values above).
DATABASE_URL=postgresql://ticketing:change_me_local_only@localhost:5432/ticketing?schema=public

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign the session JWT stored in the httpOnly cookie.
JWT_SECRET=replace_with_a_long_random_string
# Session lifetime.
SESSION_TTL=7d

# ── SMTP (email verification) ─────────────────────────────────
# Local dev: point at MailHog (host process) or any local catcher.
# DataArt/QA environment: SMTP_HOST=relay1.dataart.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ticketing <no-reply@ticketing.local>"

# ── App URLs ──────────────────────────────────────────────────
# Public base URL of the frontend — used to build verification links.
APP_BASE_URL=http://localhost:5173
# Port the backend listens on.
BACKEND_PORT=3000

# ── Dev seed (npm run seed) ───────────────────────────────────
# Optional. Local-only verified demo user for manual testing, created solely by
# `npm run seed` (never on the default startup path — a fresh DB stays empty).
# Leave blank in any deployed/QA environment; create real data via the UI/API.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
